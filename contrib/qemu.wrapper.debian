#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sh
import shutil
import sys
import time


def main():
    qemu_rootdir = '/'

    if 'QEMU_ROOTDIR' in os.environ:
        qemu_rootdir = os.path.normpath(os.environ['QEMU_ROOTDIR'])
    else:
        os.environ['QEMU_ROOTDIR'] = qemu_rootdir

    current_dir = os.getcwd()

    if qemu_rootdir != '/':
        if 'UNSHARED' in os.environ:
            # system dirs and files
            for d in ['proc', 'sys', 'dev', 'run']:
                os.makedirs(os.path.join(qemu_rootdir, d), exist_ok=True)
                sh.mount('--bind', os.path.join('/', d), os.path.join(qemu_rootdir, d))

            sh.mount('--bind', '/dev/pts', os.path.join(qemu_rootdir, 'dev/pts'))

            sh.mount('--bind', '/etc/passwd', os.path.join(qemu_rootdir, 'etc/passwd'))
            sh.mount('--bind', '/etc/group', os.path.join(qemu_rootdir, 'etc/group'))

            if os.path.ismount('/sys/fs/cgroup'):
                sh.mount('--bind', '/sys/fs/cgroup', os.path.join(qemu_rootdir, 'sys/fs/cgroup'))

            # kvmrun dirs
            for d in ['etc/kvmrun', 'usr/lib/kvmrun', 'var/lib/kvmrun', 'usr/share/kvmrun']:
                os.makedirs(os.path.join(qemu_rootdir, d), exist_ok=True)
                sh.mount('--bind', os.path.join('/', d), os.path.join(qemu_rootdir, d))

            # run chrooted QEMU binary
            os.chroot(qemu_rootdir)
            os.chdir(current_dir)

            qemuBinary = shutil.which('qemu-system-x86_64')
            if qemuBinary is None:
                raise FileNotFoundError(f'unable to find "qemu-system-x86_64" binary in "{qemu_rootdir}" directory')

            sys.argv[0] = qemuBinary

            os.execv(qemuBinary, sys.argv)

        # Unshare and restart
        os.environ['UNSHARED'] = '1'

        unshareBinary = shutil.which('unshare')
        if unshareBinary is None:
            raise FileNotFoundError(f'unable to find "unshare" binary file')

        os.execv(unshareBinary, ['-m'] + sys.argv)

    # Run without chroot
    qemuBinary = shutil.which('qemu-system-x86_64')
    if qemuBinary is None:
        raise FileNotFoundError(f'unable to find "qemu-system-x86_64" binary in "{qemu_rootdir}" directory')

    sys.argv[0] = qemuBinary

    os.execv(qemuBinary, sys.argv)


if __name__ == '__main__':
    try:
        main()
    except Exception as e:
        raise
